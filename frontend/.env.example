# Base URL of the Pramaan FastAPI backend.
# Copy this file to .env.local (or .env.development) and adjust if needed.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase credentials are intentionally NOT defined here. Authentication is
# mediated by the FastAPI backend (/api/v1/auth/*), so the browser never needs
# VITE_SUPABASE_URL or an anon/service key. Only the backend reads
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY from its own
# environment; never ship those to the frontend bundle.
